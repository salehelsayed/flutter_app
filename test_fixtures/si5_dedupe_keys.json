[
  {
    "description": "1:1 new_message -> message:<peerId>|<messageId>",
    "push": { "type": "new_message", "sender_id": "peer-123", "message_id": "msg-7" },
    "dartPayload": "peer-123",
    "dartMessageId": "msg-7",
    "expectedKey": "message:peer-123|msg-7"
  },
  {
    "description": "group_message -> double message: shape message:group:<gid>|message:<id>|<id>",
    "push": { "type": "group_message", "groupId": "g-1", "message_id": "m-9" },
    "dartPayload": "group:g-1|message:m-9",
    "dartMessageId": "m-9",
    "expectedKey": "message:group:g-1|message:m-9|m-9"
  },
  {
    "description": "older-relay aliases: from (sender) + id (messageId)",
    "push": { "type": "new_message", "from": "peer-bob", "id": "msg-2" },
    "dartPayload": "peer-bob",
    "dartMessageId": "msg-2",
    "expectedKey": "message:peer-bob|msg-2"
  },
  {
    "description": "m-only messageId alias is NOT accepted by either side -> no key",
    "push": { "type": "new_message", "sender_id": "peer-x", "m": "msg-z" },
    "dartPayload": null,
    "dartMessageId": null,
    "expectedKey": null
  },
  {
    "description": "non-message push (no message-aware dedupe) -> no key",
    "push": { "type": "group_invite" },
    "dartPayload": null,
    "dartMessageId": null,
    "expectedKey": null
  },
  {
    "description": "1:1 message_reaction bounded identity",
    "push": {
      "type": "message_reaction",
      "sender_id": "peer-reactor",
      "event_id": "reaction-event-123",
      "target_message_id": "target-message-7",
      "action": "add"
    },
    "dartPayload": "peer-reactor",
    "dartMessageId": "reaction-event-123",
    "expectedKey": "message:peer-reactor|reaction-event-123",
    "reactionEventId": "reaction-event-123",
    "expectedReactionIdentity": "reaction:813117a606a0d109f3414152f6092e5c33da6c311a4a7736"
  },
  {
    "description": "group_reaction uses the target-anchored group route and ADD event identity",
    "push": {
      "type": "group_reaction",
      "groupId": "group-397",
      "event_id": "group-reaction-event-397",
      "target_message_id": "group-target-message-397",
      "action": "add"
    },
    "dartPayload": "group:group-397|message:group-target-message-397",
    "dartMessageId": "group-reaction-event-397",
    "expectedKey": "message:group:group-397|message:group-target-message-397|group-reaction-event-397",
    "reactionEventId": "group-reaction-event-397",
    "expectedReactionIdentity": "reaction:10c907601fe55501c75e69af43feb6e7d3f0461533b56089"
  }
]
