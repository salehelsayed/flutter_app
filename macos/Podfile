platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

go_mknoon_input_files = Dir[File.expand_path(File.join('..', 'go-mknoon', '**', '*.go'), __dir__)].sort + [
  File.expand_path(File.join('..', 'go-mknoon', 'go.mod'), __dir__),
  File.expand_path(File.join('..', 'go-mknoon', 'go.sum'), __dir__),
  File.expand_path(File.join('Runner', 'MainFlutterWindow.swift'), __dir__),
  File.expand_path(File.join('..', 'scripts', 'ensure_go_macos_bindings.sh'), __dir__),
  File.expand_path(File.join('..', 'scripts', 'verify_gomobile_bindings.sh'), __dir__),
]
go_mknoon_output_files = [
  File.expand_path(File.join('Runner', 'GoMknoon.xcframework', 'Info.plist'), __dir__),
  File.expand_path(File.join('Runner', 'GoMknoon.xcframework', 'macos-arm64_x86_64', 'GoMknoon.framework', 'Versions', 'A', 'Headers', 'Bridge.objc.h'), __dir__),
]

go_mknoon_ensure = File.expand_path(File.join('..', 'scripts', 'ensure_go_macos_bindings.sh'), __dir__)
unless system(go_mknoon_ensure)
  raise 'Failed to build or verify GoMknoon macOS bindings'
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  script_phase(
    :name => 'Ensure GoMknoon macOS Bindings',
    :execution_position => :before_compile,
    :shell_path => '/bin/bash',
    :input_files => go_mknoon_input_files,
    # NOTE: intentionally NO :output_files. Declaring the GoMknoon.xcframework
    # as this Runner script's output made the GoMknoon pod's "[CP] Copy
    # XCFrameworks" phase (which consumes that xcframework) order AFTER this
    # script, closing a build cycle:
    #   Pods-Runner -> GoMknoon -> Runner -> Pods-Runner
    # (Xcode: "Cycle in dependencies between targets 'Pods-Runner' and
    # 'Runner'"). The xcframework is already built at `pod install` time (the
    # go_mknoon_ensure block above) and this before_compile script is a fast
    # idempotent freshness guard, so running it every build is harmless and the
    # missing output declaration breaks the cycle without losing freshness.
    :script => <<-'SCRIPT'
"${PODS_ROOT}/../../scripts/ensure_go_macos_bindings.sh"
SCRIPT
  )
  pod 'GoMknoon', :path => '.'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end
end
