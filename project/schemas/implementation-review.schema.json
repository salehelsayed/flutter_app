{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mknoon.local/schemas/implementation-review.schema.json",
  "title": "Mknoon revisioned implementation reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "featureId", "reviews"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "featureId": { "type": "string" },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behaviorId",
          "revision",
          "decision",
          "reviewedAt",
          "reviewer",
          "evidence"
        ],
        "properties": {
          "behaviorId": { "type": "string" },
          "revision": { "type": "string" },
          "decision": { "enum": ["confirmed", "rejected", "unclear"] },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "reviewer": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
