+      final built = await _build(
+        coordinator,
+        presenter,
+        provisionalNativeLifecycle: lifecycle,
+        authenticatedDisplayNameResolver: (_) async => 'Sender',
+      );
+
+      expect(
+        await built.handler.handle(direct(built.envelope)),
+        IncomingCallSignalOutcome.rejected,
