+            unawaited(
+              coordinator.dispatch(
+                CallEvent(
+                  type: CallEventType.remoteTerminate,
+                  eventId: 'terminate-after-presentation',
+                  occurredAt: DateTime.fromMillisecondsSinceEpoch(
+                    _nowMs,
+                    isUtc: true,
+                  ),
+                  callId: _callId,
+                  contactPeerId: 'sender-account',
+                ),
+              ),
+            );
+          }
+        },
